# Sums of the step records of each run (output: data/step-sums.csv). Result format CSV.
# Missing values count as 0 in the sums; the *With* columns give how many steps have a value, so a sum over
# only some steps can be told apart from a complete one.
PREFIX rm: <http://example.org/ontology/run-metadata#>
SELECT ?run (COUNT(DISTINCT ?p) AS ?steps)
       (COUNT(?pe) AS ?stepsWithEnergy) (SUM(COALESCE(?pe, 0)) AS ?stepEnergyKWh)
       (COUNT(?pc) AS ?stepsWithCarbon) (SUM(COALESCE(?pc, 0)) AS ?stepCarbonKg)
       (SUM(COALESCE(?pcpu, 0)) AS ?stepCpuS) (SUM(COALESCE(?pt, 0)) AS ?stepTasks)
WHERE {
  ?run rm:workflow <http://example.org/vivo-import/run-metadata/workflow/long-term-vegetation-dynamics-in-the-mediterranean-nf-core> ;
       rm:hasWorkflowProcess ?p .
  OPTIONAL { ?p rm:energyKWh ?pe } OPTIONAL { ?p rm:carbonEmissionKgCO2e ?pc }
  OPTIONAL { ?p rm:cpuTimeSeconds ?pcpu } OPTIONAL { ?p rm:taskCount ?pt }
}
GROUP BY ?run
