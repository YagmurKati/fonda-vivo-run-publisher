# After the upload: runs or steps with more than one carbon value. Expected: no rows.
PREFIX rm: <http://example.org/ontology/run-metadata#>
SELECT ?s (COUNT(?c) AS ?values) WHERE {
  {
    ?s rm:workflow <http://example.org/vivo-import/run-metadata/workflow/long-term-vegetation-dynamics-in-the-mediterranean-nf-core> .
  } UNION {
    ?run rm:workflow <http://example.org/vivo-import/run-metadata/workflow/long-term-vegetation-dynamics-in-the-mediterranean-nf-core> ;
         rm:hasWorkflowProcess ?s .
  }
  ?s rm:carbonEmissionKgCO2e ?c .
} GROUP BY ?s HAVING (COUNT(?c) > 1)
