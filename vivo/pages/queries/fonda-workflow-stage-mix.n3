# $This file is distributed under the terms of the license in LICENSE$
#
# FONDA 2026-10-18: data for "stage mix per run" on workflow pages. Runs on every page of class rm:Workflow and
# returns one row per stage execution of each run of the workflow (rm:hasWorkflowProcess / rm:isWorkflowProcessOf)
# with its CPU time, the stage of the workflow it belongs to (rm:hasStageExecution) and its names, plus the start
# time of the run. The template adds these up per run: share of a stage = its CPU time / CPU time of all stages.
# Template: themes/tenderfoot/templates/body/partials/individual/individual-workflow-stage-mix.ftl
# To undo: remove this file from rdf/display/everytime and restart Tomcat.

@prefix display: <http://vitro.mannlib.cornell.edu/ontologies/display/1.1#> .

<http://example.org/ontology/run-metadata#Workflow>
    display:hasDataGetter display:fondaWorkflowStageMixDataGetter .

display:fondaWorkflowStageMixDataGetter
    a <java:edu.cornell.mannlib.vitro.webapp.utils.dataGetter.SparqlQueryDataGetter> ;
    display:saveToVar "workflowStageMixRows" ;
    display:uri "individualURI" ;
    display:query """
        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
        PREFIX rm:   <http://example.org/ontology/run-metadata#>
        SELECT DISTINCT ?run ?start ?proc ?cpu ?stage
               (STR(?stageLabel) AS ?stageName)
               (STR(?jobName)    AS ?procName)
               (STR(?procLabel)  AS ?procLabelText)
        WHERE {
            { ?individualURI rm:hasRun ?run }
            UNION { ?individualURI rm:hasWorkflowRun ?run }
            UNION { ?run rm:workflow ?individualURI }
            { ?run rm:hasWorkflowProcess ?proc } UNION { ?proc rm:isWorkflowProcessOf ?run }
            ?proc rm:cpuTimeSeconds ?cpu .
            OPTIONAL { ?run rm:startTime ?start }
            OPTIONAL {
                ?stage rm:hasStageExecution ?proc .
                OPTIONAL { ?stage rdfs:label ?stageLabel }
            }
            OPTIONAL { ?proc rm:jobName ?jobName }
            OPTIONAL { ?proc rdfs:label ?procLabel }
        }
    """ .
