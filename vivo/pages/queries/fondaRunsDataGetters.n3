@prefix display: <http://vitro.mannlib.cornell.edu/ontologies/display/1.1#> .

<freemarker:page-classgroup.ftl> display:hasDataGetter display:fondaRunsByStartDataGetter .
<freemarker:individualsForClassesMenuPage.ftl> display:hasDataGetter display:fondaRunsByStartDataGetter .

display:fondaRunsByStartDataGetter
    a <java:edu.cornell.mannlib.vitro.webapp.utils.dataGetter.SparqlQueryDataGetter> ;
    display:saveToVar "runsByStartDG" ;
    display:query """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rm:   <http://example.org/ontology/run-metadata#>

SELECT ?run (SAMPLE(?label) AS ?runLabel) (MAX(STR(?rawStart)) AS ?start)
WHERE {
    ?run a rm:RunMetadata ; rdfs:label ?label .
    OPTIONAL { ?run rm:startTime ?rawStart }
}
GROUP BY ?run
ORDER BY DESC(?start) ?run
""" .
