#
# FONDA 2026-09-29: data for the "Collaboration with other subprojects" chord.
# Runs on every page of class fonda:Subproject. One row per (publication of this
# subproject, subproject tagged on that publication), via vivo:hasSubjectArea.
# Template: themes/tenderfoot/templates/body/partials/individual/individual-subproject-collaboration.ftl
# To undo: remove this file from rdf/display/everytime and restart Tomcat.

@prefix display: <http://vitro.mannlib.cornell.edu/ontologies/display/1.1#> .

<https://fonda.hu-berlin.de/vocab#Subproject>
    display:hasDataGetter display:fondaSubprojectCollabDataGetter .

display:fondaSubprojectCollabDataGetter
    a <java:edu.cornell.mannlib.vitro.webapp.utils.dataGetter.SparqlQueryDataGetter> ;
    display:saveToVar "subprojectCollabRows" ;
    display:uri "individualURI" ;
    display:query """
        PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
        PREFIX vivo:  <http://vivoweb.org/ontology/core#>
        PREFIX obo:   <http://purl.obolibrary.org/obo/>
        PREFIX bibo:  <http://purl.org/ontology/bibo/>
        PREFIX fonda: <https://fonda.hu-berlin.de/vocab#>
        SELECT DISTINCT ?pub ?pubLabel ?sp ?spLabel
        WHERE {
            ?pub vivo:hasSubjectArea ?individualURI .
            FILTER ( EXISTS { ?pub a obo:IAO_0000030 } || EXISTS { ?pub a bibo:Document } )
            ?pub vivo:hasSubjectArea ?sp .
            FILTER ( EXISTS { ?sp a fonda:Subproject }
                     || CONTAINS(STR(?sp), "#subproject-")
                     || CONTAINS(STR(?sp), "/fonda-group-") )
            OPTIONAL { ?pub rdfs:label ?pubLabel }
            OPTIONAL { ?sp rdfs:label ?spLabel }
        }
    """ .
