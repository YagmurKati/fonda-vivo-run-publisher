#
# FONDA 2026-11-02: data for the "Field" and "Purpose" boxes on the Workflows page (/workflows, list "Workflow Name").
# Runs whenever the template fonda-workflow-domains.ftl is included (only on that page) and returns one row per
# workflow (rm:Workflow), research field (rm:researchField) and purpose (rm:workflowPurpose), with their names; a
# workflow without a field or purpose gives a row without it. New workflows, fields and purposes appear by themselves.
# Template: themes/tenderfoot/templates/fonda-workflow-domains.ftl
# To undo: remove this file from rdf/display/everytime and restart Tomcat.

@prefix display: <http://vitro.mannlib.cornell.edu/ontologies/display/1.1#> .

<freemarker:fonda-workflow-domains.ftl>
    display:hasDataGetter display:fondaWorkflowDomainsDataGetter .

display:fondaWorkflowDomainsDataGetter
    a <java:edu.cornell.mannlib.vitro.webapp.utils.dataGetter.SparqlQueryDataGetter> ;
    display:saveToVar "fondaWfDomainRows" ;
    display:query """
        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
        PREFIX rm:   <http://example.org/ontology/run-metadata#>
        SELECT ?fondaWf
               (SAMPLE(COALESCE(STR(?fondaWfLabel), "")) AS ?fondaWfName)
               (SAMPLE(COALESCE(STR(?fondaF), "")) AS ?fondaField)
               (SAMPLE(COALESCE(STR(?fondaFLabel), "")) AS ?fondaFieldName)
               (SAMPLE(COALESCE(STR(?fondaP), "")) AS ?fondaPurpose)
               (SAMPLE(COALESCE(STR(?fondaPLabel), "")) AS ?fondaPurposeName)
        WHERE {
            ?fondaWf a rm:Workflow .
            OPTIONAL { ?fondaWf rdfs:label ?fondaWfLabel }
            OPTIONAL { ?fondaWf rm:researchField ?fondaF . OPTIONAL { ?fondaF rdfs:label ?fondaFLabel } }
            OPTIONAL { ?fondaWf rm:workflowPurpose ?fondaP . OPTIONAL { ?fondaP rdfs:label ?fondaPLabel } }
        }
        GROUP BY ?fondaWf ?fondaF ?fondaP
    """ .
