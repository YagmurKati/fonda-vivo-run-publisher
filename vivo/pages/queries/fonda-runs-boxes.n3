#
# FONDA 2026-10-04: data for the "Sort" and "Cluster" boxes on the Runs page (/runs).
# Runs whenever the template fonda-runs-boxes.ftl is included, and returns one row per workflow run
# (class rm:RunMetadata, shown as "Workflow Run") and compute cluster (rm:computeCluster of the run, or
# rm:hasRun of the cluster), with the name and the start time (rm:startTime) of the run, so new runs and
# new clusters appear by themselves. A run without a cluster gives one row without a cluster.
# Template: themes/tenderfoot/templates/fonda-runs-boxes.ftl
# To undo: remove this file from rdf/display/everytime and restart Tomcat.

@prefix display: <http://vitro.mannlib.cornell.edu/ontologies/display/1.1#> .

<freemarker:fonda-runs-boxes.ftl>
    display:hasDataGetter display:fondaRunsBoxesDataGetter .

display:fondaRunsBoxesDataGetter
    a <java:edu.cornell.mannlib.vitro.webapp.utils.dataGetter.SparqlQueryDataGetter> ;
    display:saveToVar "fondaRunsRows" ;
    display:query """
        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
        PREFIX rm:   <http://example.org/ontology/run-metadata#>
        SELECT ?fondaRun ?fondaCluster
               (SAMPLE(STR(?fondaRunLabel))     AS ?fondaRunName)
               (SAMPLE(STR(?fondaStartTime))    AS ?fondaStart)
               (SAMPLE(STR(?fondaClusterLabel)) AS ?fondaClusterName)
        WHERE {
            ?fondaRun a rm:RunMetadata .
            OPTIONAL { ?fondaRun rdfs:label ?fondaRunLabel }
            OPTIONAL { ?fondaRun rm:startTime ?fondaStartTime }
            OPTIONAL {
                { ?fondaRun rm:computeCluster ?fondaCluster }
                UNION
                { ?fondaCluster rm:hasRun ?fondaRun . ?fondaCluster a rm:ComputeCluster }
                OPTIONAL { ?fondaCluster rdfs:label ?fondaClusterLabel }
            }
        }
        GROUP BY ?fondaRun ?fondaCluster
    """ .
