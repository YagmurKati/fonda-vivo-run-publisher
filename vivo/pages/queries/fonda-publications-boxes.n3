#
# FONDA 2026-10-13: data for the "Sort" and "Year" boxes on the Publications page (/publications).
# Runs whenever the template fonda-publications-boxes.ftl is included (only on that page) and returns one row
# per publication (every information content entity that is not a journal or other collection) with its title,
# its publication date (vivo:dateTimeValue), the start of its date/time interval (used when there is no
# date/time value) and its types, so new publications appear by themselves.
# Template: themes/tenderfoot/templates/fonda-publications-boxes.ftl
# To undo: remove this file from rdf/display/everytime and restart Tomcat.

@prefix display: <http://vitro.mannlib.cornell.edu/ontologies/display/1.1#> .

<freemarker:fonda-publications-boxes.ftl>
    display:hasDataGetter display:fondaPublicationsBoxesDataGetter .

display:fondaPublicationsBoxesDataGetter
    a <java:edu.cornell.mannlib.vitro.webapp.utils.dataGetter.SparqlQueryDataGetter> ;
    display:saveToVar "fondaPubsRows" ;
    display:query """
        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
        PREFIX owl:  <http://www.w3.org/2002/07/owl#>
        PREFIX obo:  <http://purl.obolibrary.org/obo/>
        PREFIX bibo: <http://purl.org/ontology/bibo/>
        PREFIX vivo: <http://vivoweb.org/ontology/core#>
        SELECT ?fondaPub
               (SAMPLE(COALESCE(STR(?fondaPubLabel), "")) AS ?fondaPubName)
               (MAX(COALESCE(STR(?fondaPubDateTime), "")) AS ?fondaPubDate)
               (MAX(COALESCE(STR(?fondaPubStartTime), "")) AS ?fondaPubStart)
               (GROUP_CONCAT(DISTINCT STR(?fondaPubType); separator=" ") AS ?fondaPubTypes)
        WHERE {
            ?fondaPub a obo:IAO_0000030 .
            FILTER NOT EXISTS { ?fondaPub a bibo:Collection }
            ?fondaPub a ?fondaPubType .
            FILTER ( ?fondaPubType != owl:Thing && !STRSTARTS(STR(?fondaPubType), "http://purl.obolibrary.org/obo/BFO_") )
            OPTIONAL { ?fondaPub rdfs:label ?fondaPubLabel }
            OPTIONAL { ?fondaPub vivo:dateTimeValue ?fondaPubDtv . ?fondaPubDtv vivo:dateTime ?fondaPubDateTime }
            OPTIONAL { ?fondaPub vivo:dateTimeInterval ?fondaPubDti . ?fondaPubDti vivo:start ?fondaPubDts .
                       ?fondaPubDts vivo:dateTime ?fondaPubStartTime }
        }
        GROUP BY ?fondaPub
    """ .
