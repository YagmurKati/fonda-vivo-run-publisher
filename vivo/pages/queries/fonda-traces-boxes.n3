# $This file is distributed under the terms of the license in LICENSE$
#
# FONDA 2026-11-03: data for the Traces page (/traces). Runs whenever the template fonda-traces-boxes.ftl is included
# (only on that page) and returns one row per trace (rm:RunTrace, rm:TraceCollection) and research field of its
# workflow, with its name, class, download link (rm:traceArchive), where it ran (the run's compute cluster, or
# rm:traceInfrastructure) and who ran it (the run's rm:runOperator) or provided it (rm:traceProvidedBy).
# Traces of runs that are not public (rm:visibility) are left out.
# Template: themes/tenderfoot/templates/fonda-traces-boxes.ftl
# To undo: remove this file from rdf/display/everytime and restart Tomcat.

@prefix display: <http://vitro.mannlib.cornell.edu/ontologies/display/1.1#> .

<freemarker:fonda-traces-boxes.ftl>
    display:hasDataGetter display:fondaTracesBoxesDataGetter .

display:fondaTracesBoxesDataGetter
    a <java:edu.cornell.mannlib.vitro.webapp.utils.dataGetter.SparqlQueryDataGetter> ;
    display:saveToVar "fondaTraceRows" ;
    display:query """
        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
        PREFIX rm:   <http://example.org/ontology/run-metadata#>
        SELECT ?fondaTrace
               (SAMPLE(COALESCE(STR(?fondaTraceLabel), "")) AS ?fondaTraceName)
               (SAMPLE(STR(?fondaTraceType)) AS ?fondaTraceClass)
               (SAMPLE(COALESCE(STR(?fondaTraceUrl), "")) AS ?fondaTraceLink)
               (SAMPLE(COALESCE(STR(?fondaF), "")) AS ?fondaField)
               (SAMPLE(COALESCE(STR(?fondaFLabel), "")) AS ?fondaFieldName)
               (SAMPLE(COALESCE(STR(?fondaClusterLabel), STR(?fondaInfra), "")) AS ?fondaWhere)
               (GROUP_CONCAT(DISTINCT STR(?fondaWhoName); separator=", ") AS ?fondaWho)
        WHERE {
            VALUES ?fondaTraceType { rm:RunTrace rm:TraceCollection }
            ?fondaTrace a ?fondaTraceType .
            FILTER NOT EXISTS { ?fondaTrace rm:traceOf ?fondaHidden . ?fondaHidden rm:visibility ?fondaVis .
                                FILTER (?fondaVis != rm:VisibilityPublic) }
            OPTIONAL { ?fondaTrace rdfs:label ?fondaTraceLabel }
            OPTIONAL { ?fondaTrace rm:traceArchive ?fondaTraceUrl }
            OPTIONAL { ?fondaTrace rm:traceInfrastructure ?fondaInfra }
            OPTIONAL { ?fondaTrace rm:traceOf ?fondaWf . ?fondaWf a rm:Workflow .
                       OPTIONAL { ?fondaWf rm:researchField ?fondaF . OPTIONAL { ?fondaF rdfs:label ?fondaFLabel } } }
            OPTIONAL { ?fondaTrace rm:traceOf ?fondaRun . ?fondaRun a rm:RunMetadata .
                       OPTIONAL { ?fondaRun rm:computeCluster ?fondaCluster . ?fondaCluster rdfs:label ?fondaClusterLabel }
                       OPTIONAL { ?fondaRun rm:runOperator ?fondaOp . ?fondaOp rdfs:label ?fondaOpLabel } }
            OPTIONAL { ?fondaTrace rm:traceProvidedBy ?fondaBy . ?fondaBy rdfs:label ?fondaByLabel }
            BIND (COALESCE(?fondaByLabel, ?fondaOpLabel) AS ?fondaWhoName)
        }
        GROUP BY ?fondaTrace ?fondaF
    """ .
